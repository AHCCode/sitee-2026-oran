{
  "name": "afrimetiers-hub",
  "version": "1.0.0",
  "private": true,
  "description": "AFRIMÉTIERS HUB — bilingual (FR/EN) platform to discover African artisans and request quotes.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && prisma db seed",
    "test": "NODE_OPTIONS='--conditions=react-server' tsx scripts/verify-routes.ts",
    "test:api": "node scripts/smoke-test.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "prisma@6.16.2": true,
    "@prisma/client@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
